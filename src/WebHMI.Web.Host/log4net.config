<?xml version="1.0" encoding="utf-8" ?>
<log4net>

	<!--File appenders-->
	<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender" >
		<file value="../WebHMI.API_app_Data/Logs/Logs_" />
		<threshold value="INFO"/> <!--DEBUG/INFO-->
		<datePattern value="yyyy-MM-dd'.log'" />
		<appendToFile value="true" />
		<rollingStyle value="Composite" />
		<maxSizeRollBackups value="10" />
		<maximumFileSize value="100MB" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%-5level %date [%-5.5thread] %-40.40logger - %message%newline" />
		</layout>
	</appender>

	<appender name="ErrorRollingLogFileAppender" type="log4net.Appender.RollingFileAppender" >
		<file value="../WebHMI.API_app_Data/Logs/Errors_" />
		<threshold value="ERROR"/>
		<datePattern value="yyyy-MM-dd'.log'" />
		<appendToFile value="true" />
		<rollingStyle value="Composite" />
		<maxSizeRollBackups value="10" />
		<maximumFileSize value="100MB" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%-5level %date [%-5.5thread] %-40.40logger - %message%newline" />
		</layout>
	</appender>

	<appender name="L2CommunicationFileAppender" type="log4net.Appender.RollingFileAppender" >
		<file value="../WebHMI.API_app_Data/Logs/L2_Communication_Logs_" />
		<threshold value="INFO"/> <!--DEBUG/INFO-->
		<datePattern value="yyyy-MM-dd'.log'" />
		<appendToFile value="true" />
		<rollingStyle value="Composite" />
		<maxSizeRollBackups value="10" />
		<maximumFileSize value="100MB" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%-5level %date [%-5.5thread] %-40.40logger - %message%newline" />
		</layout>
	</appender>

	<!-- Console appender-->
	<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%-5level %date [%-5.5thread] %-40.40logger - %message%newline" />
		</layout>
	</appender>

	<!-- Supress certain categories/namespaces  -->
	<logger name="Abp">
		<level value="INFO" />
	</logger>

	<logger name="Microsoft">
		<level value="WARN" />
	</logger>

  <logger name="Microsoft.EntityFrameworkCore.Model.Validation">
		<level value="ERROR" />
	</logger>

	<!--Add loggers-->
	<root>
		<appender-ref ref="RollingFileAppender" />
		<appender-ref ref="ErrorRollingLogFileAppender" />
		<appender-ref ref="ConsoleAppender" />
	</root>

	<!-- Classes in L2 namespaces use only specific L2 logger -->
	<logger name="WebHMI.L2Adapter" additivity="false">
		<appender-ref ref="L2CommunicationFileAppender" />
	</logger>

</log4net>
